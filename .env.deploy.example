# cheer-service 部署配置（示例）
# 复制为 .env.deploy 后填入真实值
#   cp .env.deploy.example .env.deploy

# 远程服务器
DEPLOY_HOST=your-server-ip
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_DIR=/root/cheer-service

# CNB Docker 制品库令牌（部署令牌，只读）
# 在 CNB 页面创建，填入密钥仓库 scriptsmay/deploy-secrets/cheer-service.yml
REGISTRY_DEPLOY_TOKEN=
# 镜像版本（留空使用 latest，或指定版本号如 v1.1.0）
CHEER_SERVICE_IMAGE=

# kpl-data-daily 本地代码目录（部署时间步到远程 /root/kpl-data-daily）
KPL_SOURCE_DIR=../kpl-data-daily

# 外部健康检查 URL（部署后验证）
HEALTH_URL=https://your-api-domain/api/health
