{
  "name": "cheer-service",
  "version": "1.2.3",
  "description": "Wuyan KPL cheer backend - migrated from TCB cloud functions to Express + MongoDB",
  "type": "commonjs",
  "main": "server/src/app.js",
  "scripts": {
    "start": "node --env-file=.env server/src/app.js",
    "dev": "node --env-file=.env --watch server/src/app.js",
    "migrate": "node scripts/migrate-data.js",
    "test": "node --test server/tests/*.test.js",
    "preview:ai-cheer": "node --env-file=.env scripts/preview-ai-cheer.js",
    "dev:admin": "node scripts/dev-admin.js",
    "report:cheer-dup": "node --env-file=.env scripts/cheer-dup-report.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cron-parser": "^5.10.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "lunar-javascript": "^1.7.7",
    "mongodb": "^7.6.0",
    "node-cron": "^4.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
