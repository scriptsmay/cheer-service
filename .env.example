# cheer-service environment configuration
# Copy this file to .env and fill in the actual values before deployment

# ── MongoDB ──
MONGO_URI=mongodb://wuyan:your_password_here@localhost:27017/wuyan?authSource=admin&replicaSet=rs0
MONGO_PASSWORD=your_password_here

# ── JWT ──
JWT_SECRET=generate_a_random_secret_here

# ── AI 配置 (OpenAI 兼容标准) ──
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=deepseek-chat

# ── 鉴权 ──
AUTH_TOKEN=your_auth_token_here

# ── 用户表（JSON 数组，用于 JWT 登录） ──
APP_USERS=[{"username":"viewer","password":"your_password_here","subjectId":"viewer:default"}]

# ── CORS ──
ALLOWED_ORIGINS=https://your-domain.example.com,http://localhost:5173
ALLOW_LOCALHOST=true

# ── 内容安全 ──
BLOCKED_TERMS=赌博,色情,自杀,暴力,恐怖,毒品,诈骗,传销,政治敏感,反动,违法,违规

# ── 限流 ──
IP_HASH_SALT=generate_a_random_salt_here

# ── 数据同步源（替代 TCB 云存储） ──
DATA_BASE_URL=https://your-data-source.example.com
