# cheer-service Vercel 部署环境变量
# 在 Vercel 项目设置 → Environment Variables 中逐项填写
# 变量名会被 Vercel 自动识别

# ── 数据库（Supabase Postgres） ──
# 必填：Postgres 后端。缺省值为 mongo，不填这一项服务会去连 MongoDB 而启动失败
DB_DRIVER=postgres

# 必填：从 Supabase 控制台取连接串，两条硬规则（代码不做改写）：
#   1. 用 session 池化器端口 5432，不要写 `?pgbouncer=true`、不要用 6543 事务池化端点
#      （事务封装依赖独立连接持有 advisory lock，事务池化会打散 session 状态）
#   2. 不要在串里写 sslmode —— TLS 由代码的 ssl 配置统一控制，URL 参数会压过它导致握手失败
POSTGRES_URI=postgresql://postgres:your_password@aws-1-<region>.pooler.supabase.com:5432/postgres

# Schema 名称（代码默认 cheer）
PG_SCHEMA=cheer

# 单实例连接池上限（代码默认 5）；Vercel 总连接数 ≈ 并发 Function 实例数 × 该值
PG_POOL_MAX=5

# ── 定时任务 ──
# 必填：serverless 下关闭进程内调度器，任务改由 Vercel Cron 触发 /api/cron/daily
# SCHEDULER_ENABLED=false

# 必填：配置后 cron 请求须带 Authorization: Bearer <CRON_SECRET>；
# 不配置时生产环境（NODE_ENV=production）的 /api/cron/daily 会直接返回 401
CRON_SECRET=your_cron_secret_here

# ── JWT 鉴权 ──
# 必填：生成随机字符串
JWT_SECRET=generate_a_random_secret_here

# ── AI 配置 (OpenAI 兼容标准) ──
# 必填：DeepSeek API
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=deepseek-v4-flash

# ── 旧版 Token 鉴权（兼容） ──
AUTH_TOKEN=your_auth_token_here

# ── 用户表（JSON 数组，用于 JWT 登录） ──
# 必填：至少一个 viewer 用户
APP_USERS=[{"username":"viewer","password":"your_password_here","subjectId":"viewer:default"}]

# ── CORS ──
# 逗号分隔的白名单；前端域名必须在此列出，否则浏览器请求被拒
ALLOWED_ORIGINS=https://cheer.example.com

# ── 内容安全 ──
BLOCKED_TERMS=赌博,色情,自杀,暴力,恐怖,毒品,诈骗,传销,政治敏感,反动,违法,违规

# ── 限流 ──
IP_HASH_SALT=generate_a_random_salt_here

# ── Upstash Redis（可选：serverless 多实例共享限流计数） ──
# 不配置则回退进程内 Map（单实例足够）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── KPL 数据源（Vercel 部署使用 GitHub raw，代码默认值即为 github） ──
# 这两项可留空；显式声明更直观。KPL_SOURCE 仅接受 local | github
KPL_SOURCE=github
KPL_GITHUB_RAW_BASE=https://raw.githubusercontent.com/<owner>/<repo>/main
# KPL_DATA_DIR 仅 local 模式使用，Vercel 下不要设置
